# ──────────────────────────────────────────────────────────────────────────────
# FirstReport — Environment Configuration Template
# Copy to .env and fill in your values:  cp .env.template .env
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core APIs (required) ───────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email sharing (optional) ───────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
# Note: use an App Password, not your main Gmail password.
# Generate at: https://myaccount.google.com/apppasswords

# ── WhatsApp Business API (optional) ──────────────────────────────────────────
WHATSAPP_BUSINESS_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_id_here

# ── Google Drive (optional) ───────────────────────────────────────────────────
# Obtain token.json via the Google OAuth2 flow:
# https://developers.google.com/drive/api/quickstart/python
GOOGLE_DRIVE_CREDENTIALS=credentials.json
GOOGLE_DRIVE_TOKEN=token.json

# ── Dropbox (optional) ────────────────────────────────────────────────────────
DROPBOX_ACCESS_TOKEN=your_dropbox_token_here

# ── Python backend ─────────────────────────────────────────────────────────────
PYTHON_BACKEND_URL=http://localhost:8000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_PIN=1234
# Used only if sqlcipher3 is installed. Change before first run.

# ── Feature flags ─────────────────────────────────────────────────────────────
SHOW_DEMO_BUTTON=false
ENABLE_ENCRYPTION=true
ENABLE_EMAIL=false
ENABLE_WHATSAPP=false
ENABLE_DRIVE=false
ENABLE_DROPBOX=false

# ── Frontend defaults ──────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=hi-IN
DEFAULT_THEME=green_brown
DEFAULT_DARK_MODE=false
